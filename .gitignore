# Project content brought in under projects/ — each user's own project repos
projects/*
!projects/README.md
!projects/.gitkeep

# Windows artifacts that show up when data is copied from a Windows machine
desktop.ini
*:Zone.Identifier

# OS junk
.DS_Store

# R session artifacts
.Rhistory
.RData
.Rproj.user/

# Google Drive service-account key — never commit credentials
*gdrive-key.json

# Claude Code memory notes, mirrored here because a devcontainer rebuild wipes $HOME.
# Personal working notes, not repo content — restore with:
#   cp -a /workspace/.claude-memory-backup/. /home/node/.claude/projects/-workspace/memory/
.claude-memory-backup/
